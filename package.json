{
  "name": "@local/dsh-markdown-flowchart",
  "version": "0.1.0",
  "private": true,
  "description": "Renders Markdown sessions with Mermaid-style flowchart fences in DSH.",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node --import tsx build.ts",
    "check": "tsc --noEmit && node --check dist/index.js && node --check dist/client.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
